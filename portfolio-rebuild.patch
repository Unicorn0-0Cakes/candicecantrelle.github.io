@@ -0,0 +1,292 @@
+/* =====================================================================
+   CC / PORTFOLIO — BASE
+   Reset, typography, links, buttons, focus, motion, utilities.
+   ===================================================================== */
+
+*, *::before, *::after { box-sizing: border-box; }
+
+html {
+  color-scheme: light;
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+}
+html[data-theme="night"] { color-scheme: dark; }
+
+body {
+  margin: 0;
+  background: var(--rf-bg);
+  background-image: var(--rf-wash), var(--rf-texture);
+  background-attachment: fixed;
+  color: var(--rf-ink);
+  font-family: var(--rf-sans);
+  font-size: var(--t-body);
+  line-height: 1.62;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+::selection { background: var(--rf-selection); }
+
+/* ---------------------------------------------------------------------
+   TYPE
+   ------------------------------------------------------------------ */
+h1, h2, h3, h4 {
+  font-family: var(--rf-display);
+  font-weight: 600;
+  letter-spacing: -.018em;
+  line-height: 1.14;
+  margin: 0;
+  text-wrap: balance;
+}
+h1 { font-size: var(--t-h1); }
+h2 { font-size: var(--t-h2); }
+h3 { font-size: var(--t-h3); letter-spacing: -.012em; }
+h4 { font-size: var(--t-body); letter-spacing: -.008em; }
+
+p { margin: 0 0 var(--s-4); max-width: var(--measure); }
+p:last-child { margin-bottom: 0; }
+
+.lede {
+  font-size: clamp(16px, 1.5vw, 18px);
+  line-height: 1.58;
+  color: var(--rf-ink-dim);
+  max-width: 58ch;
+}
+.dim   { color: var(--rf-ink-dim); }
+.muted { color: var(--rf-muted); }
+
+/* The institutional label. Used for kickers, metadata, field names —
+   anything that is apparatus rather than content. */
+.label {
+  font-family: var(--w-label-font);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track);
+  text-transform: uppercase;
+  font-weight: 600;
+  color: var(--rf-muted);
+  margin: 0;
+}
+.label--accent { color: var(--w-accent); }
+
+strong, b { font-weight: 600; }
+em { font-style: italic; }
+
+hr {
+  border: 0;
+  border-top: 1px solid var(--rf-line);
+  margin: var(--s-7) 0;
+}
+hr.double { border-top: 3px double var(--rf-ink); opacity: .5; }
+
+code, kbd, samp, pre {
+  font-family: var(--rf-mono);
+  font-size: .92em;
+}
+code {
+  background: var(--rf-panel2);
+  border: 1px solid var(--rf-line-soft);
+  border-radius: 2px;
+  padding: .1em .38em;
+}
+pre {
+  background: var(--rf-panel2);
+  border: 1px solid var(--rf-line);
+  border-radius: var(--rf-radius);
+  padding: var(--s-4);
+  overflow-x: auto;
+  line-height: 1.55;
+}
+pre code { background: none; border: 0; padding: 0; }
+
+ul, ol { margin: 0 0 var(--s-4); padding-left: 1.3em; max-width: var(--measure); }
+li { margin-bottom: var(--s-2); }
+li:last-child { margin-bottom: 0; }
+
+blockquote {
+  margin: var(--s-5) 0;
+  padding-left: var(--s-4);
+  border-left: 2px solid var(--w-accent);
+  color: var(--rf-ink-dim);
+  font-style: italic;
+  max-width: var(--measure);
+}
+
+img { max-width: 100%; height: auto; display: block; }
+
+table { border-collapse: collapse; width: 100%; font-size: var(--t-small); }
+th, td { text-align: left; padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--rf-line-soft); vertical-align: top; }
+th {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-muted); font-weight: 600;
+  border-bottom: 1px solid var(--rf-line);
+}
+
+/* ---------------------------------------------------------------------
+   LINKS
+   ------------------------------------------------------------------ */
+a {
+  color: var(--w-accent);
+  text-decoration: none;
+  text-underline-offset: .18em;
+  text-decoration-thickness: 1px;
+  transition: color var(--m-quick), text-decoration-color var(--m-quick);
+}
+a:hover { text-decoration: underline; }
+
+/* Running text gets underlines by default — link affordance should not
+   depend on colour alone. */
+p a, li a, td a, blockquote a {
+  text-decoration: underline;
+  text-decoration-color: color-mix(in srgb, var(--w-accent) 45%, transparent);
+}
+p a:hover, li a:hover, td a:hover { text-decoration-color: currentColor; }
+
+/* External-link marker */
+a[data-ext]::after {
+  content: " ↗";
+  font-size: .82em;
+  opacity: .65;
+  text-decoration: none;
+  display: inline-block;
+}
+
+/* ---------------------------------------------------------------------
+   FOCUS — visible, consistent, never removed
+   ------------------------------------------------------------------ */
+:focus { outline: none; }
+:focus-visible {
+  outline: 2px solid var(--w-accent);
+  outline-offset: 3px;
+  border-radius: 2px;
+}
+html[data-theme="night"] :focus-visible { box-shadow: var(--rf-glow-soft); }
+
+.skip-link {
+  position: absolute;
+  left: var(--s-4); top: var(--s-2);
+  transform: translateY(-200%);
+  background: var(--w-accent);
+  color: var(--w-accent-on);
+  font-family: var(--rf-mono);
+  font-size: var(--t-micro);
+  letter-spacing: var(--rf-track-s);
+  text-transform: uppercase;
+  padding: var(--s-2) var(--s-4);
+  border-radius: var(--rf-radius);
+  z-index: 200;
+  transition: transform var(--m-quick);
+}
+.skip-link:focus-visible { transform: translateY(0); }
+
+/* ---------------------------------------------------------------------
+   BUTTONS
+   ------------------------------------------------------------------ */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--s-2);
+  font-family: var(--rf-mono);
+  font-size: var(--t-micro);
+  letter-spacing: var(--rf-track-s);
+  text-transform: uppercase;
+  font-weight: 600;
+  padding: 9px 16px 8px;
+  border: 1px solid var(--rf-line);
+  border-radius: var(--rf-radius);
+  background: var(--rf-panel);
+  color: var(--rf-ink);
+  cursor: pointer;
+  text-decoration: none;
+  transition: background var(--m-quick), border-color var(--m-quick),
+              color var(--m-quick), transform var(--m-quick);
+}
+.btn:hover {
+  border-color: var(--w-accent);
+  color: var(--w-accent);
+  text-decoration: none;
+  transform: translateY(-1px);
+}
+.btn--solid {
+  background: var(--w-accent);
+  border-color: var(--w-accent);
+  color: var(--w-accent-on);
+}
+.btn--solid:hover {
+  color: var(--w-accent-on);
+  filter: brightness(1.08);
+}
+html[data-theme="night"] .btn--solid:hover { box-shadow: var(--rf-glow); }
+.btn--quiet { background: transparent; border-color: transparent; padding-left: 0; padding-right: 0; }
+.btn--quiet:hover { transform: none; }
+
+/* ---------------------------------------------------------------------
+   MOTION — one switch, honoured everywhere
+   ------------------------------------------------------------------ */
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after {
+    animation-duration: .001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .001ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+html[data-motion="off"] *, html[data-motion="off"] *::before, html[data-motion="off"] *::after {
+  animation-duration: .001ms !important;
+  animation-iteration-count: 1 !important;
+  transition-duration: .001ms !important;
+}
+
+/* ---------------------------------------------------------------------
+   LAYOUT UTILITIES
+   ------------------------------------------------------------------ */
+.wrap { width: 100%; max-width: var(--page); margin: 0 auto; padding: 0 var(--page-pad); }
+.wrap--wide { max-width: var(--page-wide); }
+.wrap--narrow { max-width: 800px; }
+
+.stack > * + * { margin-top: var(--s-4); }
+.stack-lg > * + * { margin-top: var(--s-6); }
+
+.sr-only {
+  position: absolute; width: 1px; height: 1px;
+  padding: 0; margin: -1px; overflow: hidden;
+  clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+
+/* Section head — the horizontal rule with an index number, borrowed
+   from the atlas. It is the strongest single cue that two very
+   different-looking pages belong to the same site. */
+.sec-head {
+  display: flex;
+  align-items: baseline;
+  gap: var(--s-4);
+  margin: 0 0 var(--s-2);
+  padding-bottom: 9px;
+  border-bottom: 1px solid var(--rf-line);
+  font-family: var(--w-label-font);
+  font-size: var(--t-micro);
+  letter-spacing: var(--rf-track);
+  text-transform: uppercase;
+  font-weight: 600;
+  color: var(--rf-ink);
+}
+.sec-head .idx { color: var(--w-accent); font-size: var(--t-nano); }
+.sec-head .trail { flex: 1; border-bottom: 1px solid var(--rf-line-soft); }
+.sec-hint {
+  font-size: var(--t-small);
+  color: var(--rf-ink-dim);
+  margin: 0 0 var(--s-5);
+  max-width: 76ch;
+}
+
+section.doc { padding: var(--s-8) 0 0; scroll-margin-top: 72px; }
+section.doc:last-of-type { padding-bottom: var(--s-8); }
+
+@media (max-width: 640px) {
+  section.doc { padding-top: var(--s-7); }
+  body { font-size: 15px; }
+}
diff --git a/assets/css/cards.css b/assets/css/cards.css
new file mode 100644
index 0000000..18a7064
--- /dev/null
+++ b/assets/css/cards.css
@@ -0,0 +1,312 @@
+/* =====================================================================
+   CC / PORTFOLIO — CARDS
+   ---------------------------------------------------------------------
+   One geometry, several treatments.
+
+   Every card, in every wing, shares: the same corner radius, the same
+   3px accent edge on top, the same interior padding rhythm, metadata in
+   the same two places (status top-right, technical stamp bottom-left),
+   the same hover lift, the same title size. What changes between wings
+   is the VISUAL PLATE — the thing above the title — and the accent
+   colour, both of which come from the world stylesheet.
+
+   That is why a diagram card, a key-art card and a product-UI card read
+   as siblings without any of them being forced into the same picture
+   frame.
+   ===================================================================== */
+
+/* ---------------------------------------------------------------------
+   GRID
+   ------------------------------------------------------------------ */
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
+  gap: var(--s-5);
+}
+.grid--2 { grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); }
+.grid--3 { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
+.grid--wide { grid-template-columns: repeat(auto-fill, minmax(520px, 1fr)); }
+
+@media (max-width: 560px) {
+  .grid, .grid--2, .grid--3, .grid--wide { grid-template-columns: 1fr; gap: var(--s-4); }
+}
+
+/* On tablet, a two-up that does not become a lonely single column too
+   early — small screens get their own intent, not a collapsed desktop. */
+@media (min-width: 561px) and (max-width: 900px) {
+  .grid--wide { grid-template-columns: 1fr; }
+}
+
+/* ---------------------------------------------------------------------
+   BASE CARD
+   ------------------------------------------------------------------ */
+.card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  background: var(--w-card-bg);
+  border: 1px solid var(--w-card-edge);
+  border-top: var(--w-card-top) solid var(--w-accent);
+  border-radius: var(--w-radius);
+  box-shadow: var(--rf-shadow);
+  overflow: hidden;
+  transition: transform var(--m-base), box-shadow var(--m-base), border-color var(--m-base);
+  min-width: 0;
+}
+.card:hover, .card:focus-within {
+  transform: translateY(-3px);
+  box-shadow: var(--rf-shadow-lg);
+}
+html[data-theme="night"] .card:hover { border-color: color-mix(in srgb, var(--w-accent) 45%, var(--w-card-edge)); }
+
+/* Whole-card link: the title anchor stretches over the card, so the
+   click target is the card but the accessible name is the title. */
+.card__body { padding: var(--s-5) var(--s-5) var(--s-4); display: flex; flex-direction: column; flex: 1; }
+.card__title { font-size: var(--t-h3); margin: 0 0 var(--s-3); }
+.card__title a { color: var(--rf-ink); }
+.card__title a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
+.card__title a:hover { color: var(--w-accent); text-decoration: none; }
+.card:hover .card__title a { color: var(--w-accent); }
+
+.card__blurb {
+  font-size: var(--t-small);
+  line-height: 1.56;
+  color: var(--rf-ink-dim);
+  margin: 0 0 var(--s-4);
+  max-width: none;
+  flex: 1;
+}
+
+/* Metadata — always in the same two places. */
+.card__top {
+  display: flex; align-items: baseline; justify-content: space-between;
+  gap: var(--s-3); margin-bottom: var(--s-3);
+}
+.card__cat {
+  font-family: var(--w-label-font);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track);
+  text-transform: uppercase;
+  font-weight: 600;
+  color: var(--w-accent);
+}
+.card__stamp {
+  font-family: var(--rf-mono);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s);
+  text-transform: uppercase;
+  color: var(--rf-muted);
+  margin: 0;
+  padding-top: var(--s-3);
+  border-top: 1px solid var(--rf-line-soft);
+  display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3);
+}
+
+/* ---------------------------------------------------------------------
+   STATUS — the honesty control. Identical in every wing on purpose.
+   ------------------------------------------------------------------ */
+.status {
+  display: inline-flex; align-items: center; gap: 5px;
+  font-family: var(--rf-mono);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s);
+  text-transform: uppercase;
+  font-weight: 600;
+  padding: 3px 8px 2px;
+  border-radius: 999px;
+  border: 1px solid currentColor;
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+.status::before {
+  content: ""; width: 5px; height: 5px; border-radius: 50%;
+  background: currentColor; flex-shrink: 0;
+}
+.status--showcase  { color: var(--rf-ok); }
+.status--prototype { color: var(--rf-watch); }
+.status--research  { color: var(--rf-info); }
+.status--workshop  { color: var(--rf-muted); }
+.status--pending   { color: var(--rf-muted); border-style: dashed; }
+.status--pending::before { background: none; border: 1px solid currentColor; }
+
+/* ---------------------------------------------------------------------
+   THE PLATE — the visual area above the title.
+   Each treatment fills it differently; the frame is always the same.
+   ------------------------------------------------------------------ */
+.plate-area {
+  position: relative;
+  aspect-ratio: 16 / 9;
+  background: var(--rf-canvas);
+  border-bottom: 1px solid var(--rf-line);
+  overflow: hidden;
+  display: grid;
+  place-items: center;
+}
+.plate-area > img {
+  width: 100%; height: 100%; object-fit: cover;
+  transition: transform var(--m-slow);
+}
+.card:hover .plate-area > img { transform: scale(1.028); }
+.plate-area > svg { width: 100%; height: 100%; display: block; }
+
+/* Treatment: DIAGRAM — line art on a canvas, for simulations & research */
+.plate-area--diagram {
+  background: var(--rf-canvas);
+  background-image:
+    linear-gradient(var(--rf-hairline) 1px, transparent 1px),
+    linear-gradient(90deg, var(--rf-hairline) 1px, transparent 1px);
+  background-size: 22px 22px;
+}
+.plate-area--diagram svg { padding: var(--s-4); }
+
+/* Treatment: SCOPE — a dark instrument screen, always dark in both worlds */
+.plate-area--scope { background: var(--rf-scope); border-bottom-color: var(--rf-scope-line); }
+
+/* Treatment: UI — a product screenshot, inset with a chrome bar */
+.plate-area--ui { background: var(--rf-panel3); padding: var(--s-4) var(--s-4) 0; align-items: end; }
+.plate-area--ui > img,
+.plate-area--ui > .ui-shot {
+  border: 1px solid var(--rf-line);
+  border-bottom: 0;
+  border-radius: 4px 4px 0 0;
+  box-shadow: 0 -2px 18px rgba(0,0,0,.10);
+  height: 100%;
+  object-fit: cover;
+  object-position: top center;
+}
+
+/* Treatment: ART — key art, edge to edge, full bleed */
+.plate-area--art { aspect-ratio: 3 / 2; }
+
+/* Treatment: IMAGE — editorial photography, taller crop */
+.plate-area--image { aspect-ratio: 4 / 3; }
+
+/* Treatment: NONE — text-only card. The accent edge does the work. */
+.card--flat .plate-area { display: none; }
+
+/* Plate caption — a hairline strip for figure numbers / scale marks */
+.plate-cap {
+  position: absolute; left: 0; right: 0; bottom: 0;
+  display: flex; justify-content: space-between; gap: var(--s-3);
+  padding: 5px 9px;
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-canvas-ink);
+  background: color-mix(in srgb, var(--rf-canvas) 82%, transparent);
+  border-top: 1px solid var(--rf-hairline);
+  backdrop-filter: blur(4px);
+}
+.plate-area--scope .plate-cap,
+.plate-area--art .plate-cap,
+.plate-area--image .plate-cap {
+  color: #F4E6C8;
+  background: linear-gradient(to top, rgba(6,5,5,.78), rgba(6,5,5,0));
+  border-top: 0;
+  padding-top: var(--s-5);
+}
+
+/* ---------------------------------------------------------------------
+   CHIPS — short factual tags. Never claims, only descriptions.
+   ------------------------------------------------------------------ */
+.chips { display: flex; flex-wrap: wrap; gap: 5px; margin: 0 0 var(--s-4); padding: 0; list-style: none; }
+.chips li { margin: 0; }
+.chip {
+  display: inline-block;
+  font-family: var(--rf-mono);
+  font-size: var(--t-nano);
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  padding: 3px 8px 2px;
+  background: var(--rf-panel2);
+  border: 1px solid var(--rf-line-soft);
+  border-radius: 999px;
+  color: var(--rf-ink-dim);
+}
+
+/* ---------------------------------------------------------------------
+   DOORS — the discipline navigator on the homepage.
+   Not cards. Deliberately quieter and more architectural.
+   ------------------------------------------------------------------ */
+.doors {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 0;
+  border: 1px solid var(--rf-line);
+  border-radius: var(--rf-radius);
+  overflow: hidden;
+  background: var(--rf-panel);
+}
+.door {
+  position: relative;
+  display: flex; flex-direction: column; gap: var(--s-2);
+  padding: var(--s-5) var(--s-5) var(--s-6);
+  border-right: 1px solid var(--rf-line-soft);
+  border-bottom: 1px solid var(--rf-line-soft);
+  color: var(--rf-ink);
+  text-decoration: none;
+  transition: background var(--m-quick);
+  min-height: 148px;
+}
+.door::before {
+  content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px;
+  background: var(--door-accent, var(--w-accent));
+  transform: scaleX(0); transform-origin: left;
+  transition: transform var(--m-base);
+}
+.door:hover, .door:focus-visible { background: var(--rf-panel2); text-decoration: none; }
+.door:hover::before, .door:focus-visible::before { transform: scaleX(1); }
+.door__n {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); color: var(--door-accent, var(--w-accent));
+  font-weight: 600;
+}
+.door__name {
+  font-family: var(--rf-display); font-size: 18px; font-weight: 600;
+  letter-spacing: -.015em; line-height: 1.15;
+}
+.door__desc { font-size: var(--t-small); color: var(--rf-ink-dim); line-height: 1.5; flex: 1; }
+.door__count {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase; color: var(--rf-muted);
+}
+.door[aria-disabled="true"] { opacity: .55; pointer-events: none; }
+
+/* Only 4, 2 or 1 columns — three columns would leave an orphan in the
+   last row, and a half-empty row reads as an unfinished section. */
+@media (max-width: 1000px) { .doors { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 560px) {
+  .doors { grid-template-columns: 1fr; }
+  .door { min-height: 0; padding: var(--s-4) var(--s-5); }
+  .door--note { grid-column: span 1; min-height: 0; }
+}
+
+/* The eighth cell. Not a door — a closing note that makes the grid
+   resolve, and says what the seven add up to. */
+.door--note {
+  grid-column: span 2;   /* six doors + a two-wide note = eight cells, no orphan */
+  display: flex; flex-direction: column; justify-content: flex-end; gap: var(--s-2);
+  padding: var(--s-5); background: var(--rf-panel2);
+  border-right: 1px solid var(--rf-line-soft); border-bottom: 1px solid var(--rf-line-soft);
+  min-height: 148px;
+}
+.door--note p {
+  font-size: var(--t-small); color: var(--rf-ink-dim); margin: 0; max-width: none; line-height: 1.5;
+}
+.door--note .door__count { color: var(--rf-muted); }
+
+/* One measured number, promoted onto the card face. Present only where
+   a figure was actually recorded — its absence is information too. */
+.card__metric {
+  display: flex; align-items: baseline; gap: var(--s-2);
+  margin: 0 0 var(--s-4); padding: var(--s-2) 0;
+  border-top: 1px solid var(--rf-line-soft);
+  border-bottom: 1px solid var(--rf-line-soft);
+}
+.card__metric-v {
+  font-family: var(--rf-display); font-size: 22px; font-weight: 600;
+  letter-spacing: -.025em; color: var(--w-accent); line-height: 1;
+}
+.card__metric-k {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase; color: var(--rf-muted);
+}
diff --git a/assets/css/shell.css b/assets/css/shell.css
new file mode 100644
index 0000000..8754a2e
--- /dev/null
+++ b/assets/css/shell.css
@@ -0,0 +1,286 @@
+/* =====================================================================
+   CC / PORTFOLIO — SHELL
+   The architectural constant. Masthead, navigation, page header,
+   footer, return-to-portfolio. These are identical in every wing.
+   ===================================================================== */
+
+/* ---------------------------------------------------------------------
+   MASTHEAD
+   ------------------------------------------------------------------ */
+.mast {
+  position: sticky;
+  top: 0;
+  z-index: 90;
+  background: color-mix(in srgb, var(--rf-bg) 92%, transparent);
+  backdrop-filter: saturate(1.4) blur(10px);
+  -webkit-backdrop-filter: saturate(1.4) blur(10px);
+  border-bottom: 1px solid var(--rf-line);
+}
+@supports not (backdrop-filter: blur(2px)) { .mast { background: var(--rf-bg); } }
+
+.mast__inner {
+  display: flex;
+  align-items: center;
+  gap: var(--s-5);
+  min-height: 58px;
+  padding-top: var(--s-2);
+  padding-bottom: var(--s-2);
+}
+
+/* Wordmark — the return-to-portfolio control, present on every page. */
+.wordmark {
+  font-family: var(--rf-display);
+  font-size: var(--t-wordmark);
+  font-weight: 700;
+  letter-spacing: var(--rf-track-w);
+  text-transform: uppercase;
+  line-height: 1;
+  color: var(--rf-ink);
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+.wordmark:hover { color: var(--rf-ink); text-decoration: none; }
+.wordmark em { font-style: normal; color: var(--w-accent); }
+html[data-theme="night"] .wordmark em { text-shadow: var(--rf-text-glow); }
+.wordmark .slash { color: var(--rf-muted); font-weight: 400; margin: 0 .12em; }
+.wordmark .sub {
+  font-family: var(--rf-mono);
+  font-size: var(--t-nano);
+  font-weight: 500;
+  letter-spacing: var(--rf-track);
+  color: var(--rf-muted);
+}
+@media (max-width: 900px) { .wordmark .sub, .wordmark .slash { display: none; } }
+
+/* ---------------------------------------------------------------------
+   NAVIGATION
+   ------------------------------------------------------------------ */
+.nav { margin-left: auto; }
+.nav__list {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  max-width: none;
+}
+.nav__list li { margin: 0; }
+.nav__link {
+  display: block;
+  font-family: var(--rf-mono);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s);
+  text-transform: uppercase;
+  font-weight: 500;
+  color: var(--rf-ink-dim);
+  padding: 7px 9px 6px;
+  border-radius: var(--rf-radius);
+  border-bottom: 2px solid transparent;
+  white-space: nowrap;
+  transition: color var(--m-quick), border-color var(--m-quick), background var(--m-quick);
+}
+.nav__link:hover { color: var(--rf-ink); background: var(--rf-panel2); text-decoration: none; }
+.nav__link[aria-current="page"] {
+  color: var(--w-accent);
+  border-bottom-color: var(--w-accent);
+  font-weight: 600;
+}
+.nav__sep { width: 1px; height: 18px; background: var(--rf-line); margin: 0 var(--s-2); }
+
+/* Theme toggle */
+.theme-btn {
+  display: inline-flex; align-items: center; justify-content: center;
+  width: 30px; height: 28px;
+  background: transparent;
+  border: 1px solid var(--rf-line);
+  border-radius: var(--rf-radius);
+  color: var(--rf-ink-dim);
+  cursor: pointer;
+  transition: color var(--m-quick), border-color var(--m-quick);
+}
+.theme-btn:hover { color: var(--w-accent); border-color: var(--w-accent); }
+.theme-btn svg { width: 14px; height: 14px; }
+.theme-btn .i-night { display: none; }
+html[data-theme="night"] .theme-btn .i-day { display: none; }
+html[data-theme="night"] .theme-btn .i-night { display: block; }
+
+/* Mobile disclosure */
+.nav-toggle { display: none; }
+
+@media (max-width: 1080px) {
+  .nav-toggle {
+    display: inline-flex; align-items: center; gap: var(--s-2);
+    margin-left: auto;
+    font-family: var(--rf-mono); font-size: var(--t-nano);
+    letter-spacing: var(--rf-track-s); text-transform: uppercase; font-weight: 600;
+    background: transparent; color: var(--rf-ink);
+    border: 1px solid var(--rf-line); border-radius: var(--rf-radius);
+    padding: 8px 12px 7px; cursor: pointer;
+  }
+  .nav-toggle:hover { border-color: var(--w-accent); color: var(--w-accent); }
+  .nav-toggle .bars { display: block; width: 13px; height: 9px; position: relative; }
+  .nav-toggle .bars::before, .nav-toggle .bars::after,
+  .nav-toggle .bars span {
+    content: ""; position: absolute; left: 0; right: 0; height: 1.5px;
+    background: currentColor; transition: transform var(--m-quick), opacity var(--m-quick);
+  }
+  .nav-toggle .bars::before { top: 0; }
+  .nav-toggle .bars span { top: 3.75px; }
+  .nav-toggle .bars::after { bottom: 0; }
+  .nav-toggle[aria-expanded="true"] .bars::before { transform: translateY(3.75px) rotate(45deg); }
+  .nav-toggle[aria-expanded="true"] .bars span { opacity: 0; }
+  .nav-toggle[aria-expanded="true"] .bars::after { transform: translateY(-3.75px) rotate(-45deg); }
+
+  .nav {
+    position: absolute; left: 0; right: 0; top: 100%;
+    background: var(--rf-panel);
+    border-bottom: 1px solid var(--rf-line);
+    box-shadow: var(--rf-shadow-lg);
+    margin-left: 0;
+    display: none;
+  }
+  .nav[data-open="true"] { display: block; }
+  .nav__list {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 0;
+    padding: var(--s-3) var(--page-pad) var(--s-4);
+    max-width: var(--page);
+    margin: 0 auto;
+  }
+  .nav__link {
+    font-size: var(--t-micro);
+    padding: 11px 0;
+    border-bottom: 1px solid var(--rf-line-soft);
+    border-radius: 0;
+  }
+  .nav__link:hover { background: transparent; }
+  .nav__link[aria-current="page"] { border-bottom-color: var(--w-accent); }
+  .nav__sep { display: none; }
+  .nav li:last-child { margin-top: var(--s-3); }
+}
+
+/* ---------------------------------------------------------------------
+   PAGE HEADER — the plate every wing opens with
+   ------------------------------------------------------------------ */
+.plate { padding: var(--s-8) 0 var(--s-6); position: relative; }
+.plate__rule { border: 0; border-top: 3px double var(--rf-ink); opacity: .5; margin: 0; }
+.plate__kicker {
+  font-family: var(--w-label-font);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track);
+  text-transform: uppercase;
+  font-weight: 600;
+  color: var(--w-accent);
+  margin: 0 0 var(--s-3);
+  display: flex; align-items: center; gap: var(--s-3);
+}
+.plate__kicker::after {
+  content: ""; flex: 1; max-width: 120px;
+  border-bottom: 1px solid var(--w-accent); opacity: .45;
+}
+.plate h1 { font-size: var(--t-display); margin: 0 0 var(--s-4); }
+.plate__lede { font-size: clamp(16px, 1.55vw, 18.5px); line-height: 1.55; color: var(--rf-ink-dim); max-width: 62ch; margin: 0; }
+
+/* The stamp block — mono metadata, right-aligned, museum placard */
+.plate__grid { display: grid; grid-template-columns: 1fr auto; gap: var(--s-7); align-items: end; }
+@media (max-width: 860px) { .plate__grid { grid-template-columns: 1fr; gap: var(--s-5); } }
+.stamp {
+  font-family: var(--rf-mono);
+  font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s);
+  text-transform: uppercase;
+  color: var(--rf-muted);
+  line-height: 1.95;
+  text-align: right;
+  white-space: nowrap;
+  margin: 0;
+}
+@media (max-width: 860px) { .stamp { text-align: left; } }
+.stamp b { color: var(--w-accent); font-weight: 600; }
+
+/* ---------------------------------------------------------------------
+   RETURN NAVIGATION — consistent, on every page below the top level
+   ------------------------------------------------------------------ */
+.crumbs {
+  display: flex; align-items: center; gap: var(--s-2);
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-muted);
+  padding: var(--s-5) 0 0;
+  margin: 0;
+  list-style: none;
+  flex-wrap: wrap;
+}
+.crumbs li { margin: 0; display: flex; align-items: center; gap: var(--s-2); }
+.crumbs li + li::before { content: "/"; color: var(--rf-line); }
+.crumbs a { color: var(--rf-ink-dim); text-decoration: none; }
+.crumbs a:hover { color: var(--w-accent); }
+.crumbs [aria-current] { color: var(--rf-ink); }
+
+.back-link {
+  display: inline-flex; align-items: center; gap: var(--s-2);
+  font-family: var(--rf-mono); font-size: var(--t-micro);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase; font-weight: 600;
+  color: var(--rf-ink-dim);
+}
+.back-link:hover { color: var(--w-accent); text-decoration: none; }
+.back-link::before { content: "←"; }
+
+/* ---------------------------------------------------------------------
+   FOOTER
+   ------------------------------------------------------------------ */
+.foot {
+  margin-top: auto;
+  padding: var(--s-8) 0 var(--s-6);
+  border-top: 3px double var(--rf-ink);
+  border-top-color: color-mix(in srgb, var(--rf-ink) 50%, transparent);
+}
+.foot__grid {
+  display: grid;
+  grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
+  gap: var(--s-6);
+}
+@media (max-width: 900px) { .foot__grid { grid-template-columns: 1fr 1fr; gap: var(--s-5); } }
+@media (max-width: 520px) { .foot__grid { grid-template-columns: 1fr; } }
+
+.foot__brand .wordmark { font-size: 17px; }
+.foot__brand p {
+  font-size: var(--t-small);
+  color: var(--rf-ink-dim);
+  margin: var(--s-3) 0 0;
+  max-width: 34ch;
+}
+.foot h2 {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track); text-transform: uppercase; font-weight: 600;
+  color: var(--rf-muted); margin: 0 0 var(--s-3);
+}
+.foot ul { list-style: none; margin: 0; padding: 0; }
+.foot li { margin-bottom: var(--s-2); }
+.foot li a {
+  font-size: var(--t-small);
+  color: var(--rf-ink-dim);
+  text-decoration: none;
+}
+.foot li a:hover { color: var(--w-accent); }
+
+.foot__bottom {
+  display: flex; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap;
+  margin-top: var(--s-7);
+  padding-top: var(--s-4);
+  border-top: 1px solid var(--rf-line-soft);
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-muted);
+}
+
+/* ---------------------------------------------------------------------
+   REGISTRAR'S MARKS — the corner ticks that appear on plates and
+   scopes throughout the atlas. Purely typographic furniture.
+   ------------------------------------------------------------------ */
+.rm { position: absolute; width: 9px; height: 9px; pointer-events: none; opacity: .5; }
+.rm::before, .rm::after { content: ""; position: absolute; background: var(--rf-line); }
+.rm::before { left: 0; top: 4px; width: 9px; height: 1px; }
+.rm::after  { top: 0; left: 4px; width: 1px; height: 9px; }
diff --git a/assets/css/tokens.css b/assets/css/tokens.css
new file mode 100644
index 0000000..45bcd9b
--- /dev/null
+++ b/assets/css/tokens.css
@@ -0,0 +1,204 @@
+/* =====================================================================
+   CC / PORTFOLIO — TOKENS
+   ---------------------------------------------------------------------
+   The token layer is inherited from ORBITAL, the design system built for
+   the Simulations atlas. That was deliberate: Simulations is the largest
+   body of work here, its visual language was already resolved, and
+   building the portfolio on top of it means the atlas is not a wing
+   grafted onto the building — it is the wing the building was drawn
+   around.
+
+   Two complete worlds, not a palette and its inverse.
+
+     DAY   "Field Manual"  warm press paper, oxide inks, hairline rules.
+                           A 1974 technical publication, printed on a
+                           good day, on a good press.
+     NIGHT "Phosphor"      a warm-black console at 03:00. Amber CRT,
+                           faint scanlines, everything slightly emitting.
+
+   HOW CATEGORY WORLDS WORK
+     A world does not introduce new colour. It re-points three variables
+     — --w-accent, --w-accent-2, --w-texture — and optionally adjusts
+     --w-card-geometry. Everything downstream (rules, badges, focus
+     rings, card borders, links) reads those. That is the whole reason
+     seven visually distinct sections still read as one site.
+   ===================================================================== */
+
+/* ---------------------------------------------------------------------
+   1. DAY — "Field Manual"
+   ------------------------------------------------------------------ */
+:root,
+html[data-theme="day"] {
+  --rf-bg:        #EFE7D8;
+  --rf-bg2:       #E4D9C4;
+  --rf-panel:     #F8F3E7;
+  --rf-panel2:    #EDE4D2;
+  --rf-panel3:    #E3D8C2;
+  --rf-line:      #C0AE90;
+  --rf-line-soft: #DACDB4;
+
+  --rf-ink:       #241C14;
+  --rf-ink-dim:   #5B4B39;   /* darkened from Orbital's #63523F for AA on --rf-panel */
+  --rf-muted:     #6A5C3F;   /* AA at body size on panel, bg and panel2 */
+
+  --rf-orange:    #A84215;   /* the "worm" red, darkened until it clears AA as
+                                small text on panel (5.5:1), bg (5.0) and panel2 (4.8) */
+  --rf-amber:     #795807;
+  --rf-teal:      #1F5C64;
+  --rf-gold:      #7B5814;
+  --rf-oxide:     #9E2B25;
+  --rf-slate:     #4A4238;
+  --rf-violet:    #5C3E7C;
+  --rf-indigo:    #2C4A7C;
+  --rf-moss:      #3D6838;
+
+  --rf-ok:        #36693A;
+  --rf-watch:     #795807;
+  --rf-action:    #A84215;
+  --rf-danger:    #9E2B25;
+  --rf-info:      #2C5F8A;
+
+  --rf-on-accent: #FFF6E6;
+
+  --rf-shadow:    0 1px 0 rgba(36,28,20,.06), 0 6px 18px rgba(74,66,56,.10);
+  --rf-shadow-lg: 0 18px 46px rgba(74,66,56,.20);
+  --rf-glow:      none;
+  --rf-glow-soft: none;
+  --rf-text-glow: none;
+
+  --rf-radius:    3px;
+  --rf-radius-lg: 5px;
+  --rf-canvas:    #E7DCC7;
+  --rf-canvas-ink:#3A3026;
+  --rf-scope:     #0B0906;
+  --rf-scope-line:#352C1F;
+
+  --rf-texture:
+    repeating-linear-gradient(0deg, transparent 0 3px, rgba(36,28,20,.016) 3px 4px);
+  --rf-wash:
+    radial-gradient(1100px 620px at 12% -12%, rgba(168,66,21,.09), transparent 62%),
+    radial-gradient(900px 560px at 104% 2%, rgba(31,92,100,.09), transparent 58%);
+
+  --rf-selection: rgba(168,66,21,.20);
+  --rf-hairline:  rgba(36,28,20,.10);
+}
+
+/* ---------------------------------------------------------------------
+   2. NIGHT — "Phosphor"
+   ------------------------------------------------------------------ */
+html[data-theme="night"] {
+  --rf-bg:        #0A0907;
+  --rf-bg2:       #050403;
+  --rf-panel:     #15110C;
+  --rf-panel2:    #1E1811;
+  --rf-panel3:    #292117;
+  --rf-line:      #43382A;
+  --rf-line-soft: #2C241A;
+
+  --rf-ink:       #F4E6C8;
+  --rf-ink-dim:   #C2AE89;
+  --rf-muted:     #9C8B6B;   /* lifted from #8B7B5E for AA on --rf-panel */
+
+  --rf-orange:    #FF8A3D;
+  --rf-amber:     #FFC24A;
+  --rf-teal:      #4FD6C4;
+  --rf-gold:      #E8B33A;
+  --rf-oxide:     #FF5A47;
+  --rf-slate:     #9A8B72;
+  --rf-violet:    #B98CE8;
+  --rf-indigo:    #7FA8E8;
+  --rf-moss:      #8FD07A;
+
+  --rf-ok:        #5FD98A;
+  --rf-watch:     #E8B33A;
+  --rf-action:    #FF8A3D;
+  --rf-danger:    #FF5A47;
+  --rf-info:      #63B4FF;
+
+  --rf-on-accent: #14100A;
+
+  --rf-shadow:    0 1px 0 rgba(0,0,0,.6), 0 8px 26px rgba(0,0,0,.6);
+  --rf-shadow-lg: 0 22px 60px rgba(0,0,0,.75);
+  --rf-glow:      0 0 0 1px rgba(255,138,61,.22), 0 0 18px rgba(255,138,61,.20);
+  --rf-glow-soft: 0 0 22px rgba(255,194,74,.10);
+  --rf-text-glow: 0 0 12px rgba(255,194,74,.30);
+
+  --rf-radius:    2px;
+  --rf-radius-lg: 3px;
+  --rf-canvas:    #07070A;
+  --rf-canvas-ink:#F4E6C8;
+  --rf-scope:     #060505;
+  --rf-scope-line:#43382A;
+
+  --rf-texture:
+    repeating-linear-gradient(0deg, rgba(255,194,74,.030) 0 1px, transparent 1px 3px);
+  --rf-wash:
+    radial-gradient(1000px 580px at 10% -14%, rgba(255,138,61,.12), transparent 60%),
+    radial-gradient(880px 540px at 102% 0%, rgba(79,214,196,.08), transparent 58%),
+    radial-gradient(1400px 900px at 50% 120%, rgba(255,194,74,.04), transparent 70%);
+
+  --rf-selection: rgba(255,138,61,.26);
+  --rf-hairline:  rgba(244,230,200,.10);
+}
+
+/* ---------------------------------------------------------------------
+   3. TYPE, MEASURE, RHYTHM  — theme-independent
+   ------------------------------------------------------------------ */
+:root {
+  --rf-display: "Space Grotesk", "Eurostile", "Helvetica Neue", Helvetica, Arial, sans-serif;
+  --rf-sans:    "Space Grotesk", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
+  --rf-mono:    "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
+  --rf-serif:   "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
+
+  --rf-track:   .22em;   /* institutional letterspacing */
+  --rf-track-w: .34em;   /* wordmark */
+  --rf-track-s: .14em;   /* small caps / stamps */
+
+  /* Type scale — fluid, capped. Only these seven sizes exist. */
+  --t-wordmark: clamp(19px, 2.1vw, 23px);
+  --t-display:  clamp(31px, 5.2vw, 58px);
+  --t-h1:       clamp(27px, 3.9vw, 42px);
+  --t-h2:       clamp(21px, 2.5vw, 27px);
+  --t-h3:       clamp(17px, 1.7vw, 19px);
+  --t-body:     15.5px;
+  --t-small:    13.5px;
+  --t-micro:    11px;
+  --t-nano:     9.5px;
+
+  /* Spacing — an 8px base with named steps. Nothing off-scale. */
+  --s-1: 4px;   --s-2: 8px;   --s-3: 12px;  --s-4: 16px;
+  --s-5: 24px;  --s-6: 32px;  --s-7: 48px;  --s-8: 64px;
+  --s-9: 96px;  --s-10: 128px;
+
+  /* Page width. --page is the default column; --page-wide for grids that
+     genuinely need the extra room; --measure caps running text. */
+  --page:      1180px;
+  --page-wide: 1360px;
+  --page-pad:  28px;
+  --measure:   68ch;
+
+  /* Motion. Every transition in the system uses one of these three. */
+  --m-quick: 140ms cubic-bezier(.2,.6,.35,1);
+  --m-base:  200ms cubic-bezier(.2,.6,.35,1);
+  --m-slow:  380ms cubic-bezier(.22,.7,.28,1);
+
+  /* WORLD DEFAULTS — the home/neutral world. Category stylesheets
+     override only these. */
+  --w-accent:    var(--rf-orange);
+  --w-accent-2:  var(--rf-teal);
+  --w-accent-on: var(--rf-on-accent);
+  --w-rule:      1px solid var(--rf-line);
+  --w-card-bg:   var(--rf-panel);
+  --w-card-edge: var(--rf-line);
+  --w-card-top:  3px;
+  --w-radius:    var(--rf-radius);
+  --w-texture:   none;
+  --w-label-font: var(--rf-mono);
+}
+
+@media (max-width: 640px) { :root { --page-pad: 20px; } }
+
+/* Honour the OS where the visitor has not chosen for themselves. */
+@media (prefers-color-scheme: dark) {
+  html:not([data-theme]) { color-scheme: dark; }
+}
diff --git a/assets/css/worlds.css b/assets/css/worlds.css
new file mode 100644
index 0000000..e51bbdb
--- /dev/null
+++ b/assets/css/worlds.css
@@ -0,0 +1,304 @@
+/* =====================================================================
+   CC / PORTFOLIO — CATEGORY WORLDS
+   ---------------------------------------------------------------------
+   Set `data-world` on <html>. Each world re-points the --w-* variables
+   and adds a small number of section-specific rules. No world defines
+   its own colours, fonts or spacing from scratch — everything resolves
+   back to the same token layer, which is why seven distinct-looking
+   wings still read as one building.
+
+   What a world is allowed to change:
+     accent colour · plate treatment · card geometry · label typeface
+     the texture behind the page · the rhythm of its section heads
+
+   What a world may never change:
+     the masthead · the navigation · the footer · the status vocabulary
+     the metadata positions on a card · the focus ring · the page width
+   ===================================================================== */
+
+/* ═══════════════════════════════════════════════════════════════════
+   SIMULATIONS — "the instrument archive"
+   Catalogue logic, technical labels, dark scopes set into the page.
+   The closest world to the atlas it links out to.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="simulations"] {
+  --w-accent:   var(--rf-orange);
+  --w-accent-2: var(--rf-teal);
+  --w-card-top: 3px;
+}
+[data-world="simulations"] .plate::after {
+  content: ""; position: absolute; inset: auto 0 0 0; height: 1px;
+  background: repeating-linear-gradient(90deg, var(--rf-line) 0 8px, transparent 8px 16px);
+}
+/* Alternating accent on the catalogue grid, as in the atlas. */
+[data-world="simulations"] .grid > .card:nth-child(3n+2) { border-top-color: var(--rf-teal); }
+[data-world="simulations"] .grid > .card:nth-child(3n+2) .card__cat { color: var(--rf-teal); }
+[data-world="simulations"] .grid > .card:nth-child(3n+3) { border-top-color: var(--rf-violet); }
+[data-world="simulations"] .grid > .card:nth-child(3n+3) .card__cat { color: var(--rf-violet); }
+
+/* Evidence key — the trust vocabulary, spelled out rather than assumed */
+.evidence-key {
+  display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
+  gap: var(--s-3) var(--s-5);
+  padding: var(--s-5);
+  background: var(--rf-panel2);
+  border: 1px solid var(--rf-line);
+  border-left: 3px solid var(--w-accent);
+  border-radius: var(--rf-radius);
+  font-size: var(--t-small);
+}
+.evidence-key dt {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  font-weight: 600; color: var(--rf-ink);
+}
+.evidence-key dd { margin: 2px 0 0; color: var(--rf-ink-dim); font-size: var(--t-small); line-height: 1.45; }
+
+/* ═══════════════════════════════════════════════════════════════════
+   AI + ML — "the results table"
+   Cooler, more quantitative. Metrics get their own furniture, and the
+   absence of a metric is displayed as deliberately as its presence.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="ai-ml"] {
+  --w-accent:   var(--rf-indigo);
+  --w-accent-2: var(--rf-teal);
+  --w-card-top: 2px;
+}
+[data-world="ai-ml"] .plate-area--diagram {
+  background-image:
+    linear-gradient(var(--rf-hairline) 1px, transparent 1px),
+    linear-gradient(90deg, var(--rf-hairline) 1px, transparent 1px);
+  background-size: 14px 14px;
+}
+.metrics {
+  display: grid; grid-template-columns: repeat(auto-fit, minmax(126px, 1fr));
+  gap: 1px; background: var(--rf-line); border: 1px solid var(--rf-line);
+  border-radius: var(--rf-radius); overflow: hidden; margin: 0 0 var(--s-4);
+}
+.metric { background: var(--rf-panel); padding: var(--s-3) var(--s-4); }
+.metric dt {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase; color: var(--rf-muted);
+}
+.metric dd {
+  margin: 3px 0 0; font-family: var(--rf-display);
+  font-size: 21px; font-weight: 600; letter-spacing: -.02em; color: var(--w-accent);
+}
+.metric-note {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: .06em; color: var(--rf-muted); margin: 0;
+  text-transform: none; line-height: 1.6;
+}
+/* The absence notice. Used where a project has no verified numbers. */
+.no-metrics {
+  border: 1px dashed var(--rf-line);
+  border-radius: var(--rf-radius);
+  padding: var(--s-4);
+  font-size: var(--t-small);
+  color: var(--rf-ink-dim);
+  background: transparent;
+}
+.no-metrics strong {
+  display: block; font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-muted); margin-bottom: var(--s-2); font-weight: 600;
+}
+
+/* ═══════════════════════════════════════════════════════════════════
+   SOFTWARE — "the product shelf"
+   Slightly warmer geometry, slightly more finish. The only world where
+   corners soften, because these are things you are meant to pick up.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="software"] {
+  --w-accent:   var(--rf-teal);
+  --w-accent-2: var(--rf-orange);
+  --w-radius:   6px;
+  --w-card-top: 2px;
+}
+[data-world="software"] .card { border-radius: 6px; }
+[data-world="software"] .plate-area { border-radius: 5px 5px 0 0; }
+[data-world="software"] .btn { border-radius: 5px; }
+
+/* Layer diagram — used on the Key → STL case study */
+.layers { display: grid; gap: 1px; background: var(--rf-line); border: 1px solid var(--rf-line); border-radius: 6px; overflow: hidden; }
+.layer { background: var(--rf-panel); padding: var(--s-4) var(--s-5); display: grid; grid-template-columns: 120px 1fr; gap: var(--s-5); align-items: baseline; }
+@media (max-width: 620px) { .layer { grid-template-columns: 1fr; gap: var(--s-2); } }
+.layer dt {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--w-accent); font-weight: 600;
+}
+.layer dd { margin: 0; font-size: var(--t-small); color: var(--rf-ink-dim); }
+
+/* ═══════════════════════════════════════════════════════════════════
+   RESEARCH — "the notebook"
+   Serif running text, generous measure, numbered sections. The only
+   world that reads like a document rather than an interface.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="research"] {
+  --w-accent:   var(--rf-violet);
+  --w-accent-2: var(--rf-indigo);
+  --w-card-top: 2px;
+  --measure:    64ch;
+}
+[data-world="research"] .prose p,
+[data-world="research"] .prose li { font-family: var(--rf-serif); font-size: 16.5px; line-height: 1.68; }
+[data-world="research"] .plate h1 { font-family: var(--rf-serif); font-weight: 600; letter-spacing: -.01em; }
+[data-world="research"] .plate__lede { font-family: var(--rf-serif); font-style: italic; }
+
+/* Implemented vs proposed — the distinction the section exists to make */
+.ledger { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
+@media (max-width: 780px) { .ledger { grid-template-columns: 1fr; } }
+.ledger__col {
+  border: 1px solid var(--rf-line);
+  border-top: 3px solid var(--rf-ok);
+  border-radius: var(--rf-radius);
+  background: var(--rf-panel);
+  padding: var(--s-5);
+}
+.ledger__col--open { border-top-color: var(--rf-watch); }
+.ledger__col h3 {
+  font-family: var(--rf-mono); font-size: var(--t-micro);
+  letter-spacing: var(--rf-track); text-transform: uppercase;
+  color: var(--rf-ok); margin: 0 0 var(--s-3); font-weight: 600;
+}
+.ledger__col--open h3 { color: var(--rf-watch); }
+.ledger__col ul { list-style: none; padding: 0; margin: 0; }
+.ledger__col li {
+  font-size: var(--t-small); line-height: 1.5; color: var(--rf-ink-dim);
+  padding-left: 20px; position: relative; margin-bottom: var(--s-3);
+}
+.ledger__col li::before {
+  content: "✓"; position: absolute; left: 0; top: -1px;
+  color: var(--rf-ok); font-size: 12px;
+}
+.ledger__col--open li::before { content: "○"; color: var(--rf-watch); }
+
+/* ═══════════════════════════════════════════════════════════════════
+   GAMES — "the anthology"
+   More energy: bigger art, heavier display type, a darker plate that
+   lets wildly different game aesthetics sit side by side without
+   fighting. Sophisticated, not childish.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="games"] {
+  --w-accent:   var(--rf-oxide);
+  --w-accent-2: var(--rf-amber);
+  --w-card-top: 0px;
+  --w-radius:   var(--rf-radius);
+}
+[data-world="games"] .plate h1 { letter-spacing: -.03em; font-weight: 700; }
+[data-world="games"] .card { border-top-width: 0; }
+[data-world="games"] .card::before {
+  content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; z-index: 2;
+  background: linear-gradient(90deg, var(--rf-oxide), var(--rf-amber));
+}
+[data-world="games"] .plate-area { background: var(--rf-scope); border-bottom-color: var(--rf-scope-line); }
+[data-world="games"] .card__title { font-size: 21px; letter-spacing: -.025em; }
+
+/* The game placard — the full metadata schema, ready for the first
+   real entry. */
+.placard {
+  display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
+  gap: var(--s-5); margin: 0;
+  padding: var(--s-5); border: 1px solid var(--rf-line);
+  border-radius: var(--rf-radius); background: var(--rf-panel);
+}
+.placard dt {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-muted); font-weight: 600;
+}
+.placard dd { margin: 4px 0 0; font-size: var(--t-small); color: var(--rf-ink); }
+.placard dd.empty { color: var(--rf-muted); font-style: italic; }
+
+/* ═══════════════════════════════════════════════════════════════════
+   DESIGN — "the plate section"
+   Image-forward and editorial. Chrome recedes; the pictures get the
+   room. The only world where a card can be mostly picture.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="design"] {
+  --w-accent:   var(--rf-gold);
+  --w-accent-2: var(--rf-oxide);
+  --w-card-top: 0px;
+  --w-card-edge: var(--rf-line-soft);
+}
+[data-world="design"] .card { border-top-width: 0; box-shadow: none; background: transparent; border-color: transparent; }
+[data-world="design"] .card:hover { box-shadow: none; transform: translateY(-2px); }
+[data-world="design"] .card__body { padding: var(--s-4) 0 0; }
+[data-world="design"] .plate-area {
+  border: 1px solid var(--rf-line-soft); border-radius: var(--rf-radius);
+  aspect-ratio: 4 / 3;
+}
+[data-world="design"] .card__top { border-bottom: 1px solid var(--rf-line-soft); padding-bottom: var(--s-2); }
+[data-world="design"] .card__stamp { border-top-color: transparent; padding-top: 0; }
+
+/* Contact-sheet gallery */
+.sheet { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: var(--s-3); }
+.sheet figure { margin: 0; }
+.sheet img { border: 1px solid var(--rf-line-soft); border-radius: var(--rf-radius); aspect-ratio: 4/3; object-fit: cover; width: 100%; }
+.sheet figcaption {
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase;
+  color: var(--rf-muted); margin-top: 6px;
+}
+
+/* Before / after. A slider would be a toy; two labelled plates are
+   honest and work without JavaScript. */
+.compare { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
+@media (max-width: 620px) { .compare { grid-template-columns: 1fr; } }
+.compare figure { margin: 0; position: relative; }
+.compare img { border: 1px solid var(--rf-line-soft); border-radius: var(--rf-radius); width: 100%; }
+.compare figcaption {
+  position: absolute; left: var(--s-3); top: var(--s-3);
+  font-family: var(--rf-mono); font-size: var(--t-nano);
+  letter-spacing: var(--rf-track-s); text-transform: uppercase; font-weight: 600;
+  background: var(--rf-bg); color: var(--rf-ink);
+  border: 1px solid var(--rf-line); border-radius: 999px;
+  padding: 3px 9px 2px;
+}
+
+/* ═══════════════════════════════════════════════════════════════════
+   WORKSHOP — "the index card drawer"
+   Deliberately compact. Rows, not cards, so nothing here can pretend
+   to be a major piece by occupying the space of one.
+   ═══════════════════════════════════════════════════════════════ */
+html[data-world="workshop"] {
+  --w-accent:   var(--rf-moss);
+  --w-accent-2: var(--rf-gold);
+}
+[data-world="workshop"] .grid { grid-template-columns: 1fr; gap: 0; }
+[data-world="workshop"] .card {
+  flex-direction: row; align-items: stretch;
+  border-radius: 0; border-top-width: 1px; border-bottom: 0;
+  box-shadow: none; background: transparent;
+  border-left: 3px solid transparent;
+}
+[data-world="workshop"] .grid > .card:last-child { border-bottom: 1px solid var(--rf-line); }
+[data-world="workshop"] .card:hover {
+  transform: none; box-shadow: none;
+  background: var(--rf-panel); border-left-color: var(--w-accent);
+}
+[data-world="workshop"] .plate-area { display: none; }
+[data-world="workshop"] .card__body { padding: var(--s-4) var(--s-4); }
+[data-world="workshop"] .card__title { font-size: 17px; }
+[data-world="workshop"] .card__blurb { margin-bottom: var(--s-3); }
+[data-world="workshop"] .chips { margin-bottom: var(--s-3); }
+[data-world="workshop"] .card__stamp { border-top: 0; padding-top: 0; }
+
+@media (min-width: 780px) {
+  /* An index-card row: identity on the left, content on the right, and
+     no stretched empty cells — rows are sized by their content. */
+  [data-world="workshop"] .card__body {
+    display: grid;
+    grid-template-columns: 240px minmax(0, 1fr);
+    align-content: start;
+    gap: var(--s-2) var(--s-6);
+    padding: var(--s-5) var(--s-4);
+  }
+  [data-world="workshop"] .card__top   { grid-column: 1; grid-row: 1; margin: 0;
+                                         flex-direction: column; align-items: flex-start; gap: 6px; }
+  [data-world="workshop"] .card__title { grid-column: 1; grid-row: 2; margin: 0; align-self: start; }
+  [data-world="workshop"] .card__blurb { grid-column: 2; grid-row: 1 / span 2; margin: 0; flex: none; }
+  [data-world="workshop"] .chips       { grid-column: 2; grid-row: 3; margin: var(--s-2) 0 0; }
+  [data-world="workshop"] .card__stamp { grid-column: 2; grid-row: 4; margin: 0; padding-top: var(--s-2); }
+}
