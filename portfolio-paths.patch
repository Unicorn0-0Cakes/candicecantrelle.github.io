-<script src="/assets/js/shell.js"></script>
+<script>
+/* ---------------------------------------------------------------------
+   This is the only file on the site that resolves its own base URL.
+
+   A 404 is served under whatever path the visitor asked for, so the page
+   has no fixed depth and ordinary relative paths cannot work here. It
+   reads the mount point back out of the URL and falls back to the domain
+   root, which means it keeps working if the site is ever moved to one.
+
+   Written during parsing so the stylesheets still block render as normal
+   and there is no flash of unstyled content.
+   --------------------------------------------------------------------- */
+(function () {
+  var MOUNT = "candicecantrelle.github.io";
+  var path = location.pathname;
+  var base = path.indexOf("/" + MOUNT + "/") === 0 ? "/" + MOUNT + "/" : "/";
+  window.__CCBASE__ = base;
+
+  var css = ["tokens", "base", "shell", "cards", "worlds"];
+  var out = '<link rel="icon" type="image/png" href="' + base + 'favicon.png">';
+  for (var i = 0; i < css.length; i++) {
+    out += '<link rel="stylesheet" href="' + base + 'assets/css/' + css[i] + '.css">';
+  }
+  out += '<scr' + 'ipt src="' + base + 'assets/js/shell.js"><\/scr' + 'ipt>';
+  document.write(out);
+})();
+</script>
 </head>
 
 <body>
@@ -35,20 +55,29 @@
