+        everything current is one of the seven wings below.
       </p>
       <nav class="doors" id="doors" aria-label="Disciplines" style="margin-top:40px"></nav>
-      <p style="margin-top:32px"><a class="back-link" href="/">Back to the portfolio</a></p>
+      <p style="margin-top:32px"><a class="back-link" id="cc-home" href="/candicecantrelle.github.io/">Back to the portfolio</a></p>
     </div>
   </section>
 </main>
 <div data-shell-footer></div>
 
-<script src="/data/projects.js"></script>
-<script src="/assets/js/cards.js"></script>
 <script>
-CC.doors("#doors");
+(function () {
+  var base = window.__CCBASE__ || "/";
+  var a = document.getElementById("cc-archive");
+  var h = document.getElementById("cc-home");
+  if (a) a.href = base + "archive/";
+  if (h) h.href = base;
+  document.write('<scr' + 'ipt src="' + base + 'data/projects.js"><\/scr' + 'ipt>');
+  document.write('<scr' + 'ipt src="' + base + 'assets/js/cards.js"><\/scr' + 'ipt>');
+})();
+</script>
+<script>
+if (window.CC && CC.doors) CC.doors("#doors");
 </script>
 </body>
 </html>
